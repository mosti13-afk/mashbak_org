# Leave the Supabase values empty to run in demo mode (in-memory seed data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Lets notifications look up members, write the delivery log and send reminders. Server-only, never expose.
SUPABASE_SERVICE_ROLE_KEY=
# Public URL of the site (used in QR tickets and email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email (sent from info@mashbak.org)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=info@mashbak.org
SMTP_PASS=
ADMIN_EMAILS=info@mashbak.org
# WhatsApp Business Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Mashbakni assistant
ANTHROPIC_API_KEY=
# Event reminders (Cloud Scheduler)
CRON_SECRET=
