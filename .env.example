# Leave the Supabase values empty to run in demo mode (in-memory seed data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: lets admins send invitation emails when approving applications. Server-only — never expose.
SUPABASE_SERVICE_ROLE_KEY=
# Public URL of the site (used in QR tickets and email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
